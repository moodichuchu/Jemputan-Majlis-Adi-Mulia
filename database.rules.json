{
  "rules": {
    ".read": false,
    ".write": false,
    "rsvps": {
      ".read": true,
      ".indexOn": ["timestamp"],
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['nama', 'kehadiran', 'jumlah', 'ucapan', 'timestamp'])",
        "nama": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "kehadiran": { ".validate": "newData.val() === 'Attending' || newData.val() === 'Not Attending'" },
        "jumlah": { ".validate": "newData.isNumber() && ((newData.parent().child('kehadiran').val() === 'Attending' && (newData.val() === 1 || newData.val() === 2)) || (newData.parent().child('kehadiran').val() === 'Not Attending' && newData.val() === 0))" },
        "ucapan": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
